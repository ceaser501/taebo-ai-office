# 이 파일을 복사해서 .env 로 저장하고 값을 채우세요:  cp .env.example .env
# .env 는 git 에 올라가지 않습니다. 값 뒤에 주석을 붙이지 마세요.

# 실제 Claude 로 일하기 (sim 이면 시뮬레이션)
MODE=claude

# 화면 비밀번호 — 밖에 공개할 때 필수
OFFICE_PASSWORD=

# 세션 보고 토큰 — 비밀번호와 다른 값 (만들기: openssl rand -hex 24)
OFFICE_TOKEN=

# ngrok 무료 고정 주소 (ngrok 대시보드 → Domains). 예: taebo-office.ngrok-free.app
NGROK_DOMAIN=

# --- 아래는 선택 ---

# 비우면 내 맥의 claude 로그인(구독)을 쓰고, 넣으면 API 크레딧을 씁니다
ANTHROPIC_API_KEY=

# 직원들이 쓸 모델과 동시에 도는 작업 수
CLAUDE_MODEL=sonnet
MAX_PARALLEL=2

# 상태·결과물을 Supabase 에도 보관하려면 (맥 디스크에도 남으니 안 넣어도 됩니다)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
